{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,tests/**,**/__pycache__/**,alembic/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=$1" }],
  "crons": [{ "path": "/api/v1/cron/run", "schedule": "0 6 * * *" }]
}
