# Copy to backend/.env and fill in. Never commit the real file.
DHM_ENVIRONMENT=development
DHM_DATABASE_URL=postgresql+psycopg://dhm:CHANGE_ME@localhost:5432/dhm
# Disposable database used by the test suite (it is wiped on every run).
DHM_TEST_DATABASE_URL=postgresql+psycopg://dhm:CHANGE_ME@localhost:5432/dhm_test
# Celery broker: Redis recommended. PostgreSQL works too: sqla+postgresql+psycopg://dhm:...@localhost:5432/dhm
DHM_BROKER_URL=redis://localhost:6379/0
# Fernet key for encrypting stored secrets: python -m app.cli generate-key
DHM_ENCRYPTION_KEY=
# Public URL of the frontend (used in reminder email links).
DHM_APP_BASE_URL=http://localhost:3000
DHM_CORS_ORIGINS=["http://localhost:3000"]
# true in production (HTTPS only)
DHM_COOKIE_SECURE=false
