# For docker-compose.yml. Copy to .env and fill in; never commit the real file.
POSTGRES_PASSWORD=change-me
DHM_ENVIRONMENT=production
DHM_ENCRYPTION_KEY=
DHM_APP_BASE_URL=https://monitor.example.com
DHM_CORS_ORIGINS=["https://monitor.example.com"]
DHM_COOKIE_SECURE=true
# With an IAM role (recommended) no AWS keys are needed here. Otherwise store keys via the
# Email settings page (encrypted) or provide AWS_* variables to the worker only.
